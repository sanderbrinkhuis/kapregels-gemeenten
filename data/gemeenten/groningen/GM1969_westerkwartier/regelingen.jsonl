{"id": "CVDR720417_1", "work": "CVDR720417", "versie": 1, "titel": "Houtsingelhoofdstructuur zuidelijk Westerkwartier 2024", "creator": "Westerkwartier", "type": "regeling", "onderwerp": "ruimtelijke ordening, verkeer en vervoer", "vastgesteld_door": "college van burgemeester en wethouders", "issued": "2023-11-28", "modified": "2024-06-06", "inwerkingtreding": "2024-06-06", "uitwerkingtreding": "", "betreft": "nieuwe regeling", "kenmerk": "Onbekend.", "omgevingswet": "nee", "redactionele_toevoeging": "", "bron_publicatie": "gmb-2024-238766", "xml_url": "https://repository.officiele-overheidspublicaties.nl/cvdr/CVDR720417/1/xml/CVDR720417_1.xml", "url": "https://lokaleregelgeving.overheid.nl/CVDR720417/1", "work_url": "https://lokaleregelgeving.overheid.nl/CVDR720417", "status": "geldend", "gedownload": true, "xml_pad": "data/gemeenten/groningen/GM1969_westerkwartier/cvdr/CVDR720417_1.xml", "relevante_artikelen": ["1.1 Ontstaan en gebruik van houtsingels", "", "2.1 De spelregels zijn van toepassing op alle houtsingels in het Zuidelijk Westerkwartier", "2.2 Extra beschermde houtsingels en houtsingelreservaten zijn planologisch vastgelegd", "2.3 De verschijningsvorm van de houtsingel is inclusief bodem, (wal)lichaam en watergang", "2.4 Alle verschijningsvormen kennen een structuuropbouw van boom-, struik- en kruidlaag", "2.5 100% compensatieplicht voor iedere verdwenen vierkante meter houtsingel", "2.7 Coupures zijn functioneel, ook hiervoor geldt compensatieplicht.", "2.8 Bij regulier beheer lopen stobben weer uit & blijven beeldbepalende bomen staan.", "2.9 Belang en draagvlak moeten aangetoond zijn", "2.10 Landschappelijke karakteristieken maken deel uit van de beoordeling.", "3.1 Checklist en afwegingskader", "3.2.1 Regels voor kappen en rooien", "3.2.2 Algemene regels voor aanplant/herstel/compensatie", "Bijlage 1: Begrippen en definities", "Bijlage 2: Beleid, wet- en regelgeving", "Bijlage 3: Kaarten"], "integraal_relevant": false}
